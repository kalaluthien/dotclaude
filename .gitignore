# Ignore everything...
/*

# ...except these
!/.gitignore
!/CLAUDE.md
!/.claude/
/.claude/*
!/.claude/settings.json
!/settings.json
!/skills/
!/git-hooks/

# Account skills the harness syncs down; a cache, not source
/skills/synced/

# Where the harness moves a synced skill it drops
/skills/.trash/
