# Ignore everything...
/*

# ...except these
!/.gitignore
!/CLAUDE.md
!/README.md
!/LICENSE
!/NOTICE
!/CONTRIBUTING.md
!/SECURITY.md
!/.github/
!/settings.json.example
!/hooks/
!/scripts/
!/skills/

# Skills are installed by plugins, the harness and by hand; track only ours
/skills/*
!/skills/fix-me/
!/skills/grill-me/
!/skills/show-me/
!/skills/surprise-me/

# Bytecode a hook's import leaves
/hooks/__pycache__/
