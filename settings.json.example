{
  "syncClaudeAiSkills": false,
  "env": {
    "FORCE_HYPERLINK": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(rm */.git/hooks/pre-push)"
    ],
    "deny": [
      "Read(~/Downloads/**)",
      "Edit(~/Downloads/**)",
      "Read(~/Documents/**)",
      "Edit(~/Documents/**)",
      "Bash(rm -rf .claude/worktrees/*..*)",
      "SendFeedback",
      "ScheduleWakeup"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "dataviz": "off",
    "run": "off",
    "claude-api": "name-only",
    "keybindings-help": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/kill-guard.py\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/refuse-downloads.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/failure-hint.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/reply-language.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/reply-handoff.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reply to the owner in Korean, in the formal polite register and plain everyday words, whatever language their message, a file or a prompt used, and keep it after tool calls and after reading files, prompts or instructions in another language; write English in files and in messages between agents.'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/refuse-downloads.py\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": true,
  "workflowKeywordTriggerEnabled": false,
  "outputStyle": "Concise",
  "feedbackDrafts": "quiet",
  "autoCompactWindow": 250000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "skipWorkflowUsageWarning": true,
  "editorMode": "vim",
  "verbose": false,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMemoryDirectory": "~/.claude/memory"
}
