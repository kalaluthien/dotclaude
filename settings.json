{
  "autoCompactWindow": 250000,
  "syncClaudeAiSkills": false,
  "permissions": {
    "allow": [
      "Bash(merge.py https://github.com/*)",
      "Bash(worker-close.py *)",
      "Bash(tab-sweep.py *)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(herdr agent send-keys *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "dataviz": "off",
    "run": "off",
    "claude-api": "name-only",
    "keybindings-help": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/Users/hyungmokim/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": true,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "extraKnownMarketplaces": {
    "mumu-claude-plugin": {
      "source": {
        "source": "directory",
        "path": "/Users/hyungmokim/workspace/plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "quiet",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
