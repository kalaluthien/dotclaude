{
  "autoCompactWindow": 250000,
  "syncClaudeAiSkills": false,
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(grep *)",
      "Bash(git status *)",
      "Bash(git branch --show-current)",
      "Bash(herdr agent prompt *)",
      "Bash(herdr agent rename *)",
      "Bash(herdr agent read *)",
      "Bash(herdr tab rename *)",
      "Bash(worker-start.py *)",
      "Bash(lead-start.py *)",
      "Agent(mumu-team:judge)",
      "Bash(merge.py https://github.com/*)",
      "Bash(decide.py https://github.com/*)",
      "Bash(worker-close.py *)",
      "Bash(tab-sweep.py *)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git worktree remove --force .claude/worktrees/*)",
      "Bash(git worktree remove --force --force .claude/worktrees/*)",
      "Bash(git worktree unlock .claude/worktrees/*)",
      "Bash(git worktree prune)",
      "Bash(git branch -D *)",
      "Bash(git push origin --delete *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only -q)",
      "Bash(rm -rf .claude/worktrees/*)",
      "Bash(herdr agent send-keys *)",
      "Bash(rm */.git/hooks/pre-commit)",
      "Bash(rm */.git/hooks/pre-push)"
    ],
    "deny": [
      "Bash(rm -rf .claude/worktrees/*..*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "dataviz": "off",
    "run": "off",
    "claude-api": "name-only",
    "keybindings-help": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x '/Users/hyungmokim/workspace/projects/homeops/subjects/gate/hook.sh' ] && exec '/Users/hyungmokim/workspace/projects/homeops/subjects/gate/hook.sh' --rtk; exec rtk hook claude"
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/kill-guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/hyungmokim/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/reply-language.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reply in the language of the user'\"'\"'s latest message, whatever any other instruction says, and keep it after tool calls and after reading files, prompts or instructions in another language; when that language is Korean, use the formal polite register (-습니다/-ㅂ니다 endings, never -요 endings) in plain everyday words.'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableArtifact": true,
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "extraKnownMarketplaces": {
    "mumu-claude-plugin": {
      "source": {
        "source": "directory",
        "path": "/Users/hyungmokim/workspace/plugins"
      }
    }
  },
  "outputStyle": "Concise",
  "feedbackDrafts": "quiet",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": false,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "autoScrollEnabled": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
